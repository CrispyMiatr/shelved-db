# --- Application Basics ---
APP_NAME="Shelved."
APP_ENV=local  # Change to 'production' on Hetzner
APP_KEY=       # Generate with: php artisan key:generate
APP_DEBUG=true # Change to 'false' on Hetzner
APP_URL=http://localhost

# --- Database ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=shelved
DB_USERNAME=
DB_PASSWORD=

# --- Session & Cache ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# --- File Storage & Cloudflare R2 ---
FILESYSTEM_DISK=r2
MEDIA_DISK=r2

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shelved-assets
R2_ENDPOINT=
R2_URL=

# --- Cloudflare Turnstile ---
TURNSTILE_ENABLED=true
TURNSTILE_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- External Services ---
GEMINI_API_KEY=

# --- Email ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@shelvedb.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Internal Settings ---
QUEUE_CONNECTION=database
VITE_APP_NAME="${APP_NAME}"